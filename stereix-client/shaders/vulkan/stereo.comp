#version 450

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraData {
    mat4 view;
    mat4 proj;
} camera;

layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D leftEye;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D rightEye;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(leftEye);
    
    if (coord.x >= size.x || coord.y >= size.y) return;

    // Simple stereo pass logic
    vec4 color = vec4(1.0, 0.0, 0.0, 1.0); // Red for left eye
    imageStore(leftEye, coord, color);
    
    vec4 color2 = vec4(0.0, 0.0, 1.0, 1.0); // Blue for right eye
    imageStore(rightEye, coord, color2);
}
