{
  "name": "nexvr-landing-page",
  "version": "0.1.0",
  "description": "NexVR Engine marketing & waitlist landing page",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev --kv WAITLIST --d1 ANALYTICS --port 8788",
    "deploy": "wrangler pages deploy",
    "waitlist:list": "wrangler kv key list --binding WAITLIST",
    "preview": "wrangler pages dev",
    "db:init": "wrangler d1 execute nexvr-analytics --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute nexvr-analytics --remote --file=./schema.sql",
    "admin:secret": "wrangler pages secret put ADMIN_PASSWORD",
    "admin:password": "node scripts/show-password.js",
    "waitlist:export": "node scripts/export-waitlist.mjs",
    "broadcast:preview": "node scripts/send-release-broadcast.mjs --preview",
    "broadcast:dry-run": "node scripts/send-release-broadcast.mjs --dry-run",
    "broadcast:test": "node scripts/send-release-broadcast.mjs",
    "broadcast:send": "node scripts/send-release-broadcast.mjs --send"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.129.0"
  }
}
