{
  "name": "launcher",
  "private": true,
  "version": "0.1.1",
  "description": "Universal VR injection launcher",
  "author": "NexVR Engine",
  "homepage": "https://github.com/sathishssj3/NexVR-Engine",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "playwright test",
    "test:static": "playwright test regression-static.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test:ci": "npm run typecheck && npm run test:static",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "pack": "npm run build && electron-builder --win --config electron-builder.config.js"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "42.3.3",
    "electron-builder": "26.8.1",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
